# Copy to .env.local and fill in your values
NODE_ENV=local

# AI Optimize only: unset defaults to openai_compatible for legacy deployments
AI_OPTIMIZE_PROVIDER=openai_compatible
# Required only when AI_OPTIMIZE_PROVIDER=anthropic (native Messages API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI-compatible configuration for all other AI routes, and optionally Optimize

# OpenAI-compatible base URL (e.g. DeepSeek, OpenAI, Ollama, etc.)
AI_PROVIDER_BASE_URL=https://api.deepseek.com/v1
# Your API key for the provider above
AI_PROVIDER_API_KEY=your-api-key-here
# Model to use (e.g. deepseek-chat, gpt-4o, llama3)
AI_PROVIDER_MODEL=deepseek-chat

# Google Tag Manager
GTM_ID=GTM-XXXXXXX
